# Multi-stage Dockerfile for Flask API
# Optimized with BuildKit caching

# Stage 1: Build wheelhouse
FROM python:3.12-slim AS builder

WORKDIR /wheels

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and build wheels
COPY project/elastic_search/requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Stage 2: Runtime
FROM python:3.12-slim

WORKDIR /app

# Copy pre-built wheels and install
COPY --from=builder /wheels /wheels
COPY project/elastic_search/requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Copy application code
COPY project/elastic_search/ /app/

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Run as non-root user
RUN useradd -m -u 1000 flask && chown -R flask:flask /app
USER flask

EXPOSE 5000

# Healthcheck endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

ENTRYPOINT ["python", "-u"]
CMD ["app.py"]
