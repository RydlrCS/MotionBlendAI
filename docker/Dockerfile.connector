# Multi-stage Dockerfile for connector service
# Optimized with BuildKit caching

# Stage 1: Build wheelhouse
FROM python:3.12-slim AS builder

WORKDIR /wheels

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and build wheels
COPY connector/requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Stage 2: Runtime
FROM python:3.12-slim

WORKDIR /app

# Copy pre-built wheels and install
COPY --from=builder /wheels /wheels
COPY connector/requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Copy application code
COPY connector/ /app/connector/

# Create state directory
RUN mkdir -p /app/state

# Run as non-root user
RUN useradd -m -u 1000 connector && chown -R connector:connector /app
USER connector

ENTRYPOINT ["python", "-u"]
CMD ["connector/run_once.py", "--help"]
