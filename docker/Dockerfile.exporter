# Multi-stage Dockerfile for exporter service
# Optimized with BuildKit caching

# Stage 1: Build wheelhouse
FROM python:3.12-slim AS builder

WORKDIR /wheels

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and build wheels
COPY exporter/requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

# Stage 2: Runtime
FROM python:3.12-slim

WORKDIR /app

# Copy pre-built wheels and install
COPY --from=builder /wheels /wheels
COPY exporter/requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Copy application code
COPY exporter/ /app/exporter/
COPY connector/logging_util.py /app/connector/logging_util.py
COPY connector/retry_util.py /app/connector/retry_util.py
COPY connector/__init__.py /app/connector/__init__.py

# Run as non-root user
RUN useradd -m -u 1000 exporter && chown -R exporter:exporter /app
USER exporter

ENTRYPOINT ["python", "-u"]
CMD ["exporter/bigquery_to_elastic.py", "--help"]
